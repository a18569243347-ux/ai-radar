.intro {
  margin-bottom: 20rpx;
}

.mode-chips {
  margin-bottom: 8rpx;
}

.group-title {
  margin-top: 16rpx;
}

.row-top {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.p-name {
  font-size: 30rpx;
  font-weight: 600;
}

.reg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0F2F5;
}

.reg-row:last-of-type {
  border-bottom: none;
}

.reg-left {
  display: flex;
  align-items: center;
}

.reg-name {
  font-size: 28rpx;
  font-weight: 500;
}

.reg-right {
  text-align: right;
}

.reg-local {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A44;
}

.reg-cny {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 8rpx;
}

.p-price-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 12rpx 0 8rpx;
  flex-wrap: wrap;
}

.p-price {
  font-size: 34rpx;
}

.p-highlights {
  margin-top: 8rpx;
}

.p-hl {
  color: #475467;
  font-size: 26rpx;
}

.p-note {
  margin-top: 8rpx;
}

.row-actions {
  margin-top: 16rpx;
}
