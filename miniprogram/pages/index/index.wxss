.board-chips {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.chips-line {
  display: inline-flex;
}

.lb-note {
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.lb-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0F2F5;
}

.lb-row:last-child {
  border-bottom: none;
}

.lb-rank {
  width: 72rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #4F7CFF;
  flex-shrink: 0;
}

.lb-row.excluded {
  opacity: 0.5;
}

.lb-rank.lb-base {
  font-size: 22rpx;
  color: #B54708;
}

.lb-rank.excluded {
  color: #8A94A6;
}

.lb-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.lb-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.lb-name {
  font-size: 28rpx;
  font-weight: 500;
}

.lb-sub {
  font-size: 22rpx;
}

.lb-metric {
  font-size: 26rpx;
  white-space: nowrap;
}
