.hot-caption {
  margin-bottom: 8rpx;
}

.hot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0F2F5;
}

.hot-row:last-child {
  border-bottom: none;
}

.hot-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.hot-name {
  font-weight: 500;
}

.hot-price {
  font-size: 26rpx;
}
