<view class="container">
  <view class="banner-warn" wx:if="{{banner}}">{{banner}}</view>

  <scroll-view scroll-x class="board-chips">
    <view class="chips chips-line">
      <view
        class="chip {{board === item.key ? 'active' : ''}}"
        wx:for="{{boards}}"
        wx:for-item="item"
        wx:key="key"
        bindtap="onBoardTap"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="chips" wx:if="{{board === 'price'}}">
    <view
      class="chip {{priceSort === item.key ? 'active' : ''}}"
      wx:for="{{sorts}}"
      wx:for-item="item"
      wx:key="key"
      bindtap="onSortTap"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <view class="card">
    <view class="muted lb-note">{{note}}</view>
    <view class="lb-row {{item.excluded ? 'excluded' : ''}}" wx:for="{{rows}}" wx:key="id">
      <view class="lb-rank {{item.isBase ? 'lb-base' : ''}} {{item.excluded ? 'excluded' : ''}}">{{item.rank}}</view>
      <view class="lb-main">
        <view class="lb-name-line">
          <text class="lb-name">{{item.name}}</text>
          <text class="tag">{{item.isBase ? '基准' : item.tagText}}</text>
        </view>
        <view class="muted lb-sub">{{item.provider}}<text wx:if="{{item.cnyText}}">  {{item.cnyText}}</text></view>
      </view>
      <view class="lb-metric price-main">{{item.metric}}</view>
    </view>
  </view>

  <view class="footer-note">
    价格整理自公开网络，仅供参考，以各官方页面为准；本工具不构成购买建议。
  </view>
</view>
